#!/bin/sh

LABEL="com.gokuencinar.bandlockd.a9test"
PLIST="/var/jb/Library/LaunchDaemons/${LABEL}.plist"
SOCKET="/tmp/${LABEL}.sock"
OLD_SOCKET="/tmp/com.gokuencinar.bandlockd.a9test.legacy.sock"
DOMAIN="user/501"
DIAG_DIR="/var/mobile/Library/Logs/BandLockGlobal"
DIAG="${DIAG_DIR}/BandLock-A9Test-install-diag.txt"
DAEMON_DIAG="${DIAG_DIR}/BandLock-A9Test-daemon.log"
SIDECAR_LOG_DIR="${DIAG_DIR}/BandLockA9Test"

mkdir -p "$DIAG_DIR" "$SIDECAR_LOG_DIR" >/dev/null 2>&1 || true
touch "$DAEMON_DIAG" >/dev/null 2>&1 || true
chown 501:0 "$DAEMON_DIAG" "$SIDECAR_LOG_DIR" >/dev/null 2>&1 || true
chmod 0644 "$DAEMON_DIAG" >/dev/null 2>&1 || true
chmod 0755 "$SIDECAR_LOG_DIR" >/dev/null 2>&1 || true
{
    echo "BandLock A9 install diagnostic"
    date
    echo "domain=${DOMAIN}"
    echo "label=${LABEL}"
    echo "plist=${PLIST}"
    echo "binary=/var/jb/usr/libexec/BandLockA9TestDaemon"
    ls -ld "$PLIST" /var/jb/usr/libexec/BandLockA9TestDaemon 2>&1 || true
} >"$DIAG" 2>&1

launchctl bootout "${DOMAIN}/${LABEL}" >>"$DIAG" 2>&1
echo "bootout_rc=$?" >>"$DIAG"
rm -f "$SOCKET" >/dev/null 2>&1 || true
rm -f "$OLD_SOCKET" >/dev/null 2>&1 || true

launchctl enable "${DOMAIN}/${LABEL}" >>"$DIAG" 2>&1
echo "enable_rc=$?" >>"$DIAG"
launchctl bootstrap "$DOMAIN" "$PLIST" >>"$DIAG" 2>&1
echo "bootstrap_rc=$?" >>"$DIAG"
sleep 1
echo "--- launchctl print user/501 ---" >>"$DIAG"
launchctl print "${DOMAIN}/${LABEL}" >>"$DIAG" 2>&1 || true
echo "--- launchctl print system ---" >>"$DIAG"
launchctl print "system/${LABEL}" >>"$DIAG" 2>&1 || true
echo "--- socket ---" >>"$DIAG"
ls -la "$SOCKET" >>"$DIAG" 2>&1 || true




# Keep maintainer scripts UI-neutral; reload UI manually after dpkg exits.\n
exit 0
