<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gokuencinar.bandlockd.dopamine</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/libexec/BandLockDaemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>Sockets</key>
    <dict>
        <key>BandLockListener</key>
        <dict>
            <key>SockPathName</key>
            <string>/tmp/com.gokuencinar.bandlockd.dopamine.sock</string>
            <key>SockPathOwner</key>
            <integer>501</integer>
            <key>SockPathMode</key>
            <integer>384</integer>
            <key>SockType</key>
            <string>stream</string>
            <key>SockPassive</key>
            <true/>
        </dict>
    </dict>
    <key>UserName</key>
    <string>mobile</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
