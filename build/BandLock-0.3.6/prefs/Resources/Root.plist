<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>Lectura de bandas</string>
            <key>footerText</key><string>La consulta solo se ejecuta al pulsar «Leer bandas». Esta versión sigue siendo únicamente de lectura.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>Leer bandas</string>
            <key>action</key><string>reloadBands</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Estado</string>
            <key>get</key><string>statusValue</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>RAT actual</string>
            <key>get</key><string>ratValue</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Bandas soportadas</string>
            <key>get</key><string>supportedBandsValue</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Bandas activas</string>
            <key>get</key><string>activeBandsValue</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Diagnóstico</string>
            <key>get</key><string>detailValue</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>Registros SSH</string>
            <key>footerText</key><string>Cada lectura crea un registro y actualiza BandLock-last.txt. Por SSH: cat /var/mobile/Library/Logs/BandLock/BandLock-last.txt</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Último registro</string>
            <key>get</key><string>logValue</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>Eliminar todos los registros</string>
            <key>action</key><string>clearLogs</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>Información</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Versión</string>
            <key>get</key><string>versionValue</string>
        </dict>
    </array>
</dict>
</plist>
