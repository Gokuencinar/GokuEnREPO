#!/bin/sh

LABEL="com.gokuencinar.bandlockd.rootful"
PLIST="/Library/LaunchDaemons/${LABEL}.plist"
SOCKET="/tmp/${LABEL}.sock"

launchctl bootout "system/${LABEL}" >/dev/null 2>&1 || true
launchctl unload "$PLIST" >/dev/null 2>&1 || true
rm -f "$SOCKET" >/dev/null 2>&1 || true
rm -f /tmp/com.gokuencinar.bandlockd.sock >/dev/null 2>&1 || true
rm -f /tmp/com.gokuencinar.bandlockd.dopamine.sock >/dev/null 2>&1 || true

launchctl enable "system/${LABEL}" >/dev/null 2>&1 || true
if ! launchctl bootstrap system "$PLIST" >/dev/null 2>&1; then
    launchctl load -w "$PLIST" >/dev/null 2>&1 || true
fi
launchctl kickstart -k "system/${LABEL}" >/dev/null 2>&1 || true

if command -v uicache >/dev/null 2>&1; then
    uicache -p /Applications/BandLock.app >/dev/null 2>&1 || true
fi

killall BandLock >/dev/null 2>&1 || true
killall MobilePhone >/dev/null 2>&1 || true

# Do not restart SpringBoard from inside dpkg/postinst. Package managers such
# as Sileo can be terminated before dpkg commits the transaction, leaving dpkg
# in an interrupted state. The user can respring after installation if needed.

exit 0
